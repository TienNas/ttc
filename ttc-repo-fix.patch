diff --git a/qa/work7-financial-contract-check.mjs b/qa/work7-financial-contract-check.mjs
new file mode 100644
index 0000000..af47094
--- /dev/null
+++ b/qa/work7-financial-contract-check.mjs
@@ -0,0 +1,41 @@
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const root = process.cwd();
+const read = (path) => readFileSync(join(root, path), "utf8");
+const assert = (condition, message) => { if (!condition) throw new Error(message); };
+const required = (path) => assert(existsSync(join(root, path)), `Missing Work 07 file: ${path}`);
+
+const files = [
+  "packages/db/prisma/migrations/202610060001_work7_wallet_quotes/migration.sql",
+  "packages/domain/src/wallet-domain.ts",
+  "apps/web/src/app/api/v1/quotes/route.ts",
+  "apps/web/tests/backend/work7.financial.integration.test.ts",
+  "WORK7_ARCHITECTURE_HARDENING.md",
+  "scripts/work7-verify.sh"
+];
+files.forEach(required);
+
+const schema = read("packages/db/prisma/schema.prisma");
+for (const marker of ["model OrderQuote", "model WalletReservation", "WalletReservationStatus", "reservedMinor", "quoteId"]) {
+  assert(schema.includes(marker), `Missing schema marker: ${marker}`);
+}
+
+const customer = read("packages/domain/src/customer-domain.ts");
+assert(customer.includes('UPDATE "wallets"') && customer.includes('"balance_minor" - "reserved_minor"'), "Order reservation must use one atomic available-balance predicate");
+assert(customer.includes("orderQuote.updateMany") && customer.includes("expiresAt: { gt: now }"), "Quote consumption must be conditional and expiry-aware");
+assert(!customer.includes("type: WalletTransactionType.PURCHASE"), "Create order must not write a completed PURCHASE");
+
+const wallet = read("packages/domain/src/wallet-domain.ts");
+assert(wallet.includes("WalletReservationStatus.CAPTURED") && wallet.includes("WalletReservationStatus.RELEASED"), "Capture/release state guards are missing");
+assert(wallet.includes("reservation-capture:"), "Capture ledger idempotency key is missing");
+
+const worker = read("apps/worker/src/provider-worker.ts");
+assert(worker.includes("captureOrderReservationInTransaction"), "Provider acceptance must capture the reservation");
+assert(worker.includes("releaseOrderReservationInTransaction"), "Provider rejection must release the reservation");
+assert(worker.includes("UNKNOWN_SUBMISSION") && worker.includes("manualReviewProviderJob"), "Unknown submission must enter manual review");
+
+const page = read("apps/web/src/app/(app)/order/new/page.tsx");
+assert(page.includes("customerService.createQuote") && page.includes("quoteId: quote.id"), "Order UI must use the server quote flow");
+
+console.log("Work 07 financial contract passed: server quotes, atomic reservations, idempotent capture/release and worker uncertainty handling are present.");
diff --git a/scripts/apply-repository-fix.ps1 b/scripts/apply-repository-fix.ps1
new file mode 100644
index 0000000..0def342
--- /dev/null
+++ b/scripts/apply-repository-fix.ps1
@@ -0,0 +1,49 @@
+param(
+    [string]$PatchPath = ".\ttc-repo-fix.patch",
+    [string]$DestinationPath = ""
+)
+
+$ErrorActionPreference = "Stop"
+$sourceRepo = (Get-Location).Path
+$resolvedPatch = (Resolve-Path $PatchPath).Path
+$expectedHead = "5739601f2776cbcfce69e5ab115ebcbfa3da7dc0"
+$bashPath = "C:\Program Files\Git\bin\bash.exe"
+if (!(Test-Path $bashPath)) { throw "Git Bash was not found at $bashPath. Install Git for Windows before continuing." }
+if (!$DestinationPath) { $DestinationPath = Join-Path (Split-Path $sourceRepo -Parent) "ttc-work7-fixed" }
+if (Test-Path $DestinationPath) { throw "Destination already exists. Keep it intact and choose a new -DestinationPath." }
+
+function Invoke-Checked {
+    param([string]$Command, [Parameter(ValueFromRemainingArguments = $true)][string[]]$Arguments)
+    & $Command @Arguments
+    if ($LASTEXITCODE -ne 0) { throw "$Command failed with exit code $LASTEXITCODE. Stop; do not commit or push." }
+}
+
+Invoke-Checked git.exe clone https://github.com/NhatTiens/ttc.git $DestinationPath
+Set-Location $DestinationPath
+Invoke-Checked git.exe checkout main
+Invoke-Checked git.exe pull --rebase origin main
+$actualHead = (& git.exe rev-parse HEAD).Trim()
+if ($LASTEXITCODE -ne 0) { throw "Unable to read repository HEAD." }
+if ($actualHead -ne $expectedHead) {
+    throw "main has changed: $actualHead. This patch targets $expectedHead; request a rebase before applying. Your original repository is untouched."
+}
+Invoke-Checked git.exe apply --check $resolvedPatch
+Invoke-Checked git.exe apply --index $resolvedPatch
+if (!(Test-Path ".\scripts\work7-verify.sh")) { throw "The complete verification script is missing. Stop." }
+
+$sourceEnv = Join-Path $sourceRepo ".env"
+if (Test-Path $sourceEnv) {
+    Copy-Item $sourceEnv ".env"
+} else {
+    Copy-Item ".env.example" ".env"
+    throw "Code updated in $((Get-Location).Path). Configure .env (AUTH_SECRET, DATABASE_URL, separate TEST_DATABASE_URL) and start PostgreSQL, then run the commands in REPOSITORY_FIX_REPORT.md. No tests or push were performed."
+}
+
+Invoke-Checked npm.cmd ci
+Invoke-Checked npm.cmd run db:generate
+Invoke-Checked npm.cmd run db:validate
+Invoke-Checked npm.cmd run db:migrate
+Invoke-Checked $bashPath ./scripts/work7-verify.sh
+Invoke-Checked git.exe status
+Invoke-Checked git.exe diff --cached --stat
+Write-Host "All local verification gates succeeded. Review the staged diff before committing. This script never commits or pushes."
